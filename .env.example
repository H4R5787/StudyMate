# StudyMate Environment Variables Template
# Copy this file to .env or .env.local to configure real Firebase and Google Gemini AI services.

# ==============================================================================
# Firebase Authentication & Backend Configuration
# Obtain these from your Firebase Console -> Project Settings -> General
# ==============================================================================
EXPO_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
EXPO_PUBLIC_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=YOUR_FIREBASE_MEASUREMENT_ID

# ==============================================================================
# Google Gemini Generative AI Configuration
# Obtain your Gemini API Key at https://aistudio.google.com/
# ==============================================================================
EXPO_PUBLIC_GEMINI_API_KEY=YOUR_GEMINI_API_KEY
